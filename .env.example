APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Email user yang dianggap CEO buat bootstrap role & demo data (lihat
# config/organization.php) - opsional, tapi RoleSeeder butuh ini untuk
# assign role CEO ke user yang benar (skip aman kalau kosong).
CEO_EMAIL=

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Google OAuth - SATU-SATUNYA cara login aplikasi ini (tidak ada login
# email/password untuk user internal). Tanpa tiga variabel ini terisi,
# tidak ada satu pun orang yang bisa masuk. Daftarkan redirect URI di
# Google Cloud Console > Credentials > Authorized redirect URIs, harus
# persis sama dengan GOOGLE_REDIRECT_URI di sini (termasuk https:// dan
# domain produksinya, bukan localhost).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback

# Gemini API - dipakai AI Brief (BriefGenerationService) & AI Strategy
# (AiStrategyService). Tanpa ini, kedua fitur akan gagal saat generate.
GEMINI_API_KEY=

# Instagram API (Instagram Login, graph.instagram.com) - credential GLOBAL
# Meta App doang (dipakai OAuth "Connect Instagram" di InstagramIntegrationController).
# Token milik masing-masing client TIDAK di sini - tersimpan terenkripsi di
# api_integrations.access_token per client, hasil dari flow connect itu.
# Isi sendiri di .env, JANGAN commit nilai aslinya.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_API_VERSION=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# TikTok for Developers (Login Kit + Display API v2, open.tiktokapis.com) -
# credential GLOBAL TikTok App doang (dipakai OAuth "Connect TikTok" di
# TikTokIntegrationController). Token milik masing-masing client TIDAK di
# sini - tersimpan terenkripsi di api_integrations.access_token per client,
# hasil dari flow connect itu. Isi sendiri di .env, JANGAN commit nilai
# aslinya. Lihat docs/TIKTOK_INTEGRATION.md untuk setup Developer Portal.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

VITE_APP_NAME="${APP_NAME}"
